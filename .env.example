# ─────────────────────────────────────────────────────────────────────────────
# GENERATED by `npm run env:example` from src/modules.ts. Do not edit by hand.
# Copy to .env (cp .env.example .env) or let `npm run onboard` fill it in.
# Then run `npm run doctor -- --setup` to see what is still missing.
#
# Features are switched on and off in config/profile.json:
#   "modules": { "email": true, "checkins": true }
# Settings for a feature that is off are simply ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Your Claude API key (console.anthropic.com > API keys), if you chose Claude. A
# Claude subscription does not cover this; it is billed separately.
ANTHROPIC_API_KEY=

# Your OpenAI API key (platform.openai.com > API keys), if you chose OpenAI.
# Also needed for phone calls either way.
OPENAI_API_KEY=

# Your own iMessage phone number, with country code (+15551234567). Only listed
# people can talk to the assistant.
USER_OWNER=

# ── Core chat (core) — always on ──────────────────────────────────────────────
# Text the assistant over iMessage and it texts you back, can search the web,
# and keeps a household notes file.

# Which AI runs the assistant: claude or openai. Blank = whichever key is set
# (OpenAI if both).
LLM_PROVIDER=claude

# Main Claude model. claude-sonnet-5 costs less.
CLAUDE_MODEL=claude-opus-5

# Quick Claude model for sorting, lookups and web search.
CLAUDE_FAST_MODEL=claude-haiku-4-5

# How long one Claude call may take, in milliseconds.
ANTHROPIC_TIMEOUT_MS=120000

# Retries per Claude call on rate limits and network errors.
ANTHROPIC_MAX_RETRIES=3

# Main model that writes replies.
OPENAI_MODEL=gpt-5.6-terra

# Small, cheap model for quick sorting decisions.
OPENAI_ROUTER_MODEL=gpt-5.6-luna

# Model that decides what to look up in memory. Defaults to OPENAI_ROUTER_MODEL.
OPENAI_RETRIEVAL_MODEL=

# Model used for web search. Defaults to OPENAI_ROUTER_MODEL.
OPENAI_SEARCH_MODEL=

# Past messages sent with each reply. Fewer = cheaper; ongoing topics carry
# longer arcs.
HISTORY_LIMIT=40

# Longest single tool result the model sees (head and tail kept).
TOOL_OUTPUT_MAX_CHARS=30000

# Model for read-only follow-up checks. Defaults to OPENAI_ROUTER_MODEL.
FOLLOWUP_WATCH_MODEL=

# Only for an OpenAI-compatible proxy. Leave blank.
OPENAI_BASE_URL=

# How long one model call may take, in milliseconds.
OPENAI_TIMEOUT_MS=120000

# Retries per model call on rate limits and network errors.
OPENAI_MAX_ATTEMPTS=4

# Your iMessage email address, if you text from one.
USER_OWNER_EMAIL=

# Your timezone, if different from this Mac's. Usually set by the setup
# interview.
ASSISTANT_TIMEZONE=America/Chicago

# Maintainers only: path to a private list of words that must never be committed
# (npm run check:portable).
DIALZERO_DENYLIST=

# Ongoing topics: remember where each multi-day conversation (a trip, a billing
# problem) stands, so a later "what about flights" picks it up. false turns it
# off.
THREADS_ENABLED=true

# Model that matches messages to ongoing topics and updates them. Defaults to
# OPENAI_ROUTER_MODEL.
OPENAI_THREADS_MODEL=

# Model for the deep research tool (things to do, trips, where to eat). Defaults
# to OPENAI_MODEL.
OPENAI_RESEARCH_MODEL=

# Word that wakes the assistant in group chats. DMs never need it.
TRIGGER_WORD=@assistant

# Optional chat ID for a private group with the assistant. Blank = it texts your
# number directly.
GROUP_ADMIN=

# Optional chat ID for a household group chat.
GROUP_HOME=

# Optional chat ID for a health-tracking chat.
GROUP_HEALTH=

# Where scheduled messages go when no group is set. Defaults to USER_OWNER.
DM_RECIPIENT=

# Legacy alias for DM_RECIPIENT.
ASSISTANT_DEFAULT_RECIPIENT=

# Where the SQLite database lives. Default: assistant.db in this folder.
ASSISTANT_DB_PATH=

# Where the profile lives. Default: config/profile.json.
ASSISTANT_PROFILE_PATH=

# Where the context/ prompt files live. Default: context/ in this folder.
ASSISTANT_CONTEXT_ROOT=

# Time limit for the quick "reply now or work in background" decision.
ASSISTANT_ROUTER_TIMEOUT_MS=

# false = simpler keyword memory lookups.
ASSISTANT_SMART_RETRIEVAL=true

# Time limit for deciding what to look up in memory.
ASSISTANT_RETRIEVAL_TIMEOUT_MS=2000

# Time limit for sending one iMessage.
IMESSAGE_APPLESCRIPT_TIMEOUT_MS=

# After a restart, how far back to catch up on missed messages.
IMESSAGE_RECOVERY_WINDOW_MIN=

# Path to macOS sips (converts iPhone photos). Default /usr/bin/sips.
SIPS_BIN=

# Optional Instacart connector key used by mcp-servers.json.
INSTACART_API_KEY=

# While paused (npm run pause), comma list of background parts that still run,
# e.g. family-scheduler.
AUTOMATIONS_ON=

# Comma list of module ids to force on (overrides config/profile.json).
MODULES_ON=

# Comma list of module ids to force off (overrides config/profile.json).
MODULES_OFF=

# Prefix for the background service names.
LAUNCHD_LABEL_PREFIX=dev.dialzero

# Daily model spend cap in dollars. Replies are never refused; background work
# pauses.
LLM_DAILY_CAP_USD=8

# Weekly model spend cap in dollars.
LLM_WEEKLY_CAP_USD=40

# Daily cap for background work only.
LLM_AMBIENT_DAILY_CAP_USD=4

# Tighter background cap while the local model is down.
LLM_FALLBACK_DAILY_CAP_USD=1

# false = log budget breaches but keep going.
LLM_BUDGET_ENFORCED=true

# Per-model prices, USD per 1M tokens. Keep the outer single quotes. Unknown
# models are priced high on purpose, so check these against the provider pricing
# page.
LLM_PRICES_JSON='{"gpt-5.6-terra":{"input":2.0,"cachedInput":0.2,"output":12.0},"gpt-5.6-luna":{"input":0.2,"cachedInput":0.02,"output":1.2},"gpt-5.6-sol":{"input":5.0,"cachedInput":0.5,"output":30.0}}'

# ── Memory (memory) — on by default ───────────────────────────────────────────
# Remembers facts, people and past conversations, and quietly picks up promises
# and deadlines from your texts.

# How often texts are read for facts, in milliseconds.
IMESSAGE_DAEMON_INTERVAL_MS=600000

# Messages read per pass.
IMESSAGE_EXTRACT_BATCH=100

# write = save what it learns; shadow = drafts for review only (needs the local
# model).
IMESSAGE_EXTRACT_MODE=write

# Ignore messages before this ISO date. Required in shadow mode.
IMESSAGE_EXTRACT_NOT_BEFORE=

# Also mine old message history (needs the local model).
IMESSAGE_HISTORY_ENABLED=false

# ISO date; history mining reads messages before it.
IMESSAGE_HISTORY_BEFORE=

# Optional ISO date; history mining skips messages before it (newest first).
IMESSAGE_HISTORY_AFTER=

# Run history mining on this cloud model instead of the local one. Empty = local
# only, never a paid model.
IMESSAGE_HISTORY_MODEL=

# Old messages read per pass.
IMESSAGE_HISTORY_BATCH=75

# How often history mining runs.
IMESSAGE_HISTORY_INTERVAL_MS=600000

# Most facts saved per history pass.
IMESSAGE_HISTORY_MAX_OBSERVATIONS=12

# ── Calendar and tasks (calendar) — on by default ─────────────────────────────
# Reads and adds Google Calendar events and keeps a to-do list that shows up in
# Google Tasks on your phone.

# Google OAuth client ID (Google Cloud console > Credentials, type Desktop app).
# (Required when this feature is on.)
GOOGLE_CALENDAR_CLIENT_ID=

# Google OAuth client secret. (Required when this feature is on.)
GOOGLE_CALENDAR_CLIENT_SECRET=

# Written by npm run auth:google. (Required when this feature is on.)
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Only to finish npm run auth:google from another device. Default
# http://localhost:3333/callback.
GOOGLE_AUTH_REDIRECT=

# Email invited to events created from the household chat. Blank = nobody.
HOME_AUTO_ATTENDEE=

# ── Email (email) — on by default ─────────────────────────────────────────────
# Reads, searches, archives and drafts your email (Gmail, or the Spark app) and
# tracks which emails still need a reply.

# gmail (default when Google is connected), spark, or none.
EMAIL_SOURCE=gmail

# Path to the Spark command-line tool (only if EMAIL_SOURCE=spark).
SPARK_BIN=/usr/local/bin/spark

# true (default) = every 15 minutes, check tracked emails for replies and RSVPs
# (read-only).
EMAIL_RECONCILIATION_ENABLED=true

# How often tracked emails are rechecked.
EMAIL_RECONCILIATION_INTERVAL_MS=900000

# Tracked emails checked per pass.
EMAIL_RECONCILIATION_BATCH=25

# ── Email watcher (email-watcher) — off by default ────────────────────────────
# Watches new email for deliveries, bills and failed payments and adds them to
# your calendar and to-dos.

# Must be true for the watcher to act.
INBOX_SIGNAL_ENABLED=true

# How often new email is checked.
INBOX_SIGNAL_INTERVAL_MS=900000

# Emails read per pass.
INBOX_SIGNAL_BATCH=50

# How far back each pass looks.
INBOX_SIGNAL_WINDOW=2d

# ── Daily check-ins (checkins) — off by default ───────────────────────────────
# Sends one short morning and one evening message with what needs you, plus
# urgent heads-ups like "time to leave".

# When the morning check-in goes out (cron, your local time).
COS_CHECKIN_MORNING_CRON=30 8 * * *

# When the evening check-in goes out.
COS_CHECKIN_EVENING_CRON=0 18 * * *

# enforce = hold back non-urgent texts; observe = log but send everything.
COS_ARBITER_MODE=enforce

# Most unprompted texts per day.
COS_DAILY_INTERRUPT_BUDGET=3

# Extra texts allowed for truly time-critical things.
COS_INTERRUPT_BUDGET_OVERDRAFT=2

# Growing gaps between reminders about the same task.
HEARTBEAT_BACKOFF_HOURS=24,48,96,168

# Reminders before a task becomes a "keep or drop it?" question.
HEARTBEAT_RETIRE_AFTER=4

# Old setting, no longer used.
HEARTBEAT_RESURFACE_HOURS=

# ── Proactive nudges (nudges) — off by default ────────────────────────────────
# Occasionally reminds you of promises you made, people you have not talked to
# lately, and ideas it could help with, and tidies its own memory weekly.

# Minimum hours before the same reminder repeats.
PULSE_RESURFACE_HOURS=18

# true = afternoon "here is how I could help" ideas.
IDEA_PULSE_ENABLED=false

# true = weekly "you have not talked to these people lately".
RELATIONSHIP_PULSE_ENABLED=false

# When the people reminder goes out.
RELATIONSHIP_PULSE_CRON=15 11 * * 5

# Most people per reminder.
RELATIONSHIP_PULSE_MAX=5

# true = Monday memory cleanup (merges duplicates, drops expired facts).
HYGIENE_ENABLED=false

# Cleanup: facts below this confidence are candidates to drop.
HYGIENE_CONFIDENCE_THRESHOLD=0.4

# Cleanup: minimum age before a fact is demoted.
HYGIENE_DEMOTE_MIN_AGE_DAYS=30

# Cleanup: promises older than this are closed.
HYGIENE_STALE_COMMITMENT_DAYS=90

# Cleanup: times a fact is shown before it may expire.
HYGIENE_MIN_SURFACE_BEFORE_EXPIRE=3

# true = during cleanup, also merge facts that mean the same thing.
MEMORY_AUDIT_ENABLED=false

# Audit only subjects with at least this many facts.
MEMORY_AUDIT_MIN_ROWS_PER_SUBJECT=3

# Most subjects audited per week.
MEMORY_AUDIT_MAX_SUBJECTS_PER_RUN=10

# Model for the audit. Defaults to OPENAI_MODEL.
MEMORY_AUDIT_MODEL=

# ── Journal (journal) — off by default ────────────────────────────────────────
# Asks you a few reflection questions each morning and evening and saves your
# answers to Notion.

# Must be true for journal prompts to go out.
JOURNAL_ENABLED=true

# When the morning questions start.
JOURNAL_MORNING_CRON=45 7 * * *

# When the evening questions start.
JOURNAL_EVENING_CRON=30 20 * * *

# Hours before an unanswered session is dropped.
JOURNAL_SESSION_EXPIRY_H=4

# Notion integration secret (notion.so/profile/integrations). (Required when
# this feature is on.)
NOTION_TOKEN=

# ID of the Notion database that holds one page per day. (Required when this
# feature is on.)
NOTION_JOURNAL_DB=

# ── Meeting prep (meetings) — off by default ──────────────────────────────────
# Before meetings with outside people it sends you a short brief, and afterwards
# asks how it went.

# Comma list of email domains that count as "your own people"; others get a
# brief.
INTERNAL_DOMAINS=gmail.com

# ── Actions with approval (actions) — on by default ───────────────────────────
# Lets the assistant text or email people for you, but only after you reply "go"
# to approve each one.

# true = text a progress line for every step while it works (noisy; off by
# default).
PROGRESS_UPDATES=false

# false = the assistant cannot propose or carry out any action.
ACTIONS_ENABLED=true

# Most real money actions may spend per day.
ACTIONS_DAILY_CAP_USD=100

# Most real money actions may spend per week.
ACTIONS_WEEKLY_CAP_USD=400

# ── Phone calls (phone) — off by default ──────────────────────────────────────
# Gives the assistant a phone number so you can call it, it can call businesses
# for you, and it can wake you up with a call.

# Public https address that reaches this Mac (e.g. from tailscale funnel).
# (Required when this feature is on.)
PHONE_PUBLIC_URL=

# Twilio account ID. (Required when this feature is on.)
TWILIO_ACCOUNT_SID=

# Twilio auth token. (Required when this feature is on.)
TWILIO_AUTH_TOKEN=

# The Twilio phone number the assistant uses. (Required when this feature is
# on.)
TWILIO_NUMBER=

# OPENAI_API_KEY: set above.

# OpenAI project that receives the calls. (Required when this feature is on.)
OPENAI_PROJECT_ID=

# Secret of the OpenAI webhook pointed at <PHONE_PUBLIC_URL>/openai/webhook.
# (Required when this feature is on.)
OPENAI_WEBHOOK_SECRET=

# Voice model for calls.
OPENAI_REALTIME_MODEL=gpt-realtime

# Model that transcribes calls.
PHONE_TRANSCRIBE_MODEL=

# Voice the assistant speaks with.
PHONE_VOICE=marin

# Address the call server listens on. Default 127.0.0.1.
PHONE_HOST=

# Port the call server listens on.
PHONE_PORT=4011

# Only accept your calls when the carrier verifies caller ID.
PHONE_REQUIRE_VERIFIED_CALLER=true

# Extra numbers of yours, comma separated.
PHONE_OWNER_NUMBERS=

# Number left in voicemails. Blank = none.
PHONE_CALLBACK_NUMBER=

# Longest call, in minutes.
PHONE_MAX_CALL_MIN=15

# How long a call waits for an answer before saying it will text you.
PHONE_TOOL_TIMEOUT_MS=

# true = ring your phone for time-critical alerts (never at night).
PHONE_RING_ON_CRITICAL=false

# Most alert calls per day.
PHONE_RING_DAILY_CAP=3

# true (default) = business calls run in a Twilio conference, so pressing
# phone-menu keys never drops the assistant's voice. false = the older
# redirect-and-reconnect way.
PHONE_CONFERENCE=true

# true (default) = also transcribe the business's side of errand calls, so a
# dropped call can say why (only the last few lines are kept unless you ask for
# a transcript).
PHONE_TRANSCRIBE_THEM=true

# Path to the Tailscale command, used to notice when the tunnel carrying
# PHONE_PUBLIC_URL is off (calls pause and you get one text).
TAILSCALE_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale

# true (default) = the assistant answers calls from anyone else as your
# receptionist: puts contacts through, takes messages from everyone else. false
# = other callers hear a refusal.
RECEPTION_ENABLED=true

# Hours (start-end, 24h, local) when only your always-ring people get put
# through; everyone else leaves a message.
RECEPTION_QUIET=19-8

# false = no calls to businesses for you.
ERRANDS_ENABLED=true

# Earliest hour to call businesses.
ERRAND_CALL_START=9

# Latest hour to call businesses.
ERRAND_CALL_END=18

# Minutes between retries of the same number.
ERRAND_RETRY_GAP_MIN=120

# Most errand calls per day.
ERRAND_DAILY_CALL_CAP=10

# false = no wake-up calls.
WAKEUP_CALLS_ENABLED=true

# Wake-up call tries before giving up and texting.
WAKEUP_MAX_ATTEMPTS=7

# Minutes between wake-up tries.
WAKEUP_RETRY_MIN=3

# Minutes late a wake-up call may still go out after a restart.
WAKEUP_GRACE_MIN=60

# Longest wake-up call, in minutes.
WAKEUP_MAX_CALL_MIN=5

# ── Web browsing, booking and website jobs (browser) — off by default ─────────
# Lets the assistant use Chrome on this Mac to read pages, book appointments,
# cancel subscriptions, export your data and change account settings. It never
# pays without your approval.

# Shared secret the Chrome extension must send. Strongly recommended.
BROWSER_BRIDGE_TOKEN=

# Only accept this Chrome extension ID.
BROWSER_EXTENSION_ID=

# Address the extension connects to.
BROWSER_BRIDGE_HOST=127.0.0.1

# Port the extension connects to.
BROWSER_BRIDGE_PORT=9222

# Time limit for one online booking.
BOOKING_TIMEOUT_MS=

# Time limit for one browser run of a website job (it keeps going run after
# run).
WEB_TASK_TIMEOUT_MS=1800000

# Browser runs a website job may take before it gives up and texts you.
WEB_TASK_MAX_RUNS=20

# Steps one browser run may take (clicks, snapshots, screenshots) before it
# reports.
BROWSER_MAX_TURNS=40

# Where Chrome saves downloads, so website jobs can confirm an export landed.
# Default ~/Downloads.
DOWNLOADS_DIR=

# Wait after a run that did not work, before trying another way.
WEB_TASK_RETRY_GAP_MS=180000

# Wait between retries when a website job paused because the AI service failed
# (out of credit, outage).
WEB_TASK_INFRA_WAIT_MS=600000

# true = stop before the final "place order" click (practice mode).
ACTIONS_REORDER_DRY_RUN=false

# Comma list of folders the browser may upload files from. Blank = uploads off.
BROWSER_UPLOAD_ROOTS=

# Optional: a read-only 1Password service account token, so website jobs can
# sign in with logins you put in one vault (the model never sees them). Blank =
# jobs ask you to log in.
OP_SERVICE_ACCOUNT_TOKEN=

# The one 1Password vault website jobs may read logins from.
OP_VAULT=Assistant

# Path to the 1Password CLI (brew install 1password-cli).
OP_BIN=/opt/homebrew/bin/op

# Optional: https address of the take-over page (this Mac's screen in your phone
# browser, for a login a job can't do), e.g. from `tailscale serve --bg
# --https=8443 http://127.0.0.1:4013`. Needs Screen Sharing on. Blank = off.
TAKEOVER_BASE_URL=

# false = don't serve the take-over page even if TAKEOVER_BASE_URL is set.
TAKEOVER_WEB=true

# Port the take-over page listens on (127.0.0.1 only).
TAKEOVER_PORT=4013

# Screen Sharing port the take-over page relays to.
TAKEOVER_VNC_PORT=5900

# Fallback when the take-over page is off: a link sent with a login request,
# e.g. vnc://<this Mac's tailnet address> for a VNC app.
TAKEOVER_URL=

# ── Desktop control (desktop) — off by default ────────────────────────────────
# Lets the assistant see this Mac's screen and, after you approve, click and
# type for you.

# Path to cliclick (clicks and typing).
CLICLICK_BIN=/opt/homebrew/bin/cliclick

# Screenshot size the model sees.
COMPUTER_USE_SCREENSHOT_PX=1280

# true = even opening apps needs your approval.
COMPUTER_USE_GATE_ALL=false

# How long one desktop task may run.
COMPUTER_USE_TASK_WINDOW_MS=

# Path to macOS screencapture.
SCREENCAPTURE_BIN=

# Path to macOS open.
OPEN_BIN=

# Path to macOS system_profiler.
SYSTEM_PROFILER_BIN=

# ── Voice notes (voice-notes) — off by default ────────────────────────────────
# Understands voice memos you send over iMessage by transcribing them on this
# Mac.

# Path to whisper-cli.
WHISPER_BIN=/opt/homebrew/bin/whisper-cli

# Path to ffmpeg.
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg

# Path to the speech model file. Default ~/.cache/whisper/ggml-small.en.bin.
WHISPER_MODEL=

# ── Ask from Siri (siri) — off by default ─────────────────────────────────────
# Lets you ask the assistant by voice from an iPhone Shortcut and hear the
# answer.

# Password the Shortcut sends. Make it long and random. (Required when this
# feature is on.)
VOICE_TOKEN=

# Port the Shortcut endpoint listens on.
VOICE_PORT=4010

# Addresses to listen on, comma separated. Default 127.0.0.1.
VOICE_HOSTS=

# Slower answers arrive by text instead.
VOICE_SYNC_TIMEOUT_MS=25000

# ── Family chat (family) — off by default ─────────────────────────────────────
# Joins one family group chat to keep a shared calendar and lists, without ever
# seeing your private stuff.

# Chat ID of a new group with only you, your family and the assistant. (Required
# when this feature is on.)
GROUP_FAMILY=

# Written by npm run family:configure. Never "primary". (Required when this
# feature is on.)
FAMILY_CALENDAR_ID=

# Google account that owns the Family calendar. (Required when this feature is
# on.)
FAMILY_CALENDAR_ACCOUNT=

# Your partner's iMessage phone number.
USER_PARTNER=

# Your partner's iMessage email.
USER_PARTNER_EMAIL=

# Town for the daily weather line.
FAMILY_WEATHER_LOCATION=

# When the daily family update goes out.
FAMILY_DAILY_CRON="0 7 * * *"

# When the weekly family update goes out.
FAMILY_WEEKLY_CRON="30 19 * * 0"

# Wait for a burst of family texts to finish before answering.
FAMILY_MESSAGE_SETTLE_MS=

# Family texts older than this are not answered after downtime.
FAMILY_INBOX_MAX_AGE_HOURS=

# ── Builder extras (builder) — off by default ─────────────────────────────────
# For programmers: lets the assistant work in your code folders, check GitHub,
# search LinkedIn and read Notion.

# Optional chat ID for a work group chat.
GROUP_WORK=

# Path to the Codex command-line tool.
CODEX_BIN=/opt/homebrew/bin/codex

# Model Codex uses.
CODEX_MODEL=gpt-5.6-terra

# What Codex may touch. Keep workspace-write.
CODEX_SANDBOX=workspace-write

# Folder your code folders live in. Default ~/Documents/GitHub.
ASSISTANT_GH_ROOT=

# Comma list of code folders the assistant may use.
ASSISTANT_ALLOWED_REPOS=

# Where drafts are saved. Default ~/assistant-drafts.
ASSISTANT_DRAFTS_ROOT=

# Optional Notion database where "save this to Notion" captures go.
NOTION_OTHER_BRAIN_DB=

# NOTION_TOKEN: set above.

# Optional Notion database for approvals.
NOTION_APPROVE_DB=

# Optional Notion database for pipelines.
NOTION_PIPELINES_DB=

# ── Omi recordings (omi) — off by default ─────────────────────────────────────
# If you use the Omi app or wearable, the assistant can look up what you said in
# conversations and keeps your promises, to-dos and the people you talked with.

# Omi developer key (Omi app > Settings > Developer > MCP). Used by
# mcp-servers.json and the sync. (Required when this feature is on.)
OMI_MCP_KEY=

# false = lookups only; do not read new conversations into memory.
OMI_SYNC_ENABLED=true

# How often new Omi conversations are read, in minutes.
OMI_SYNC_INTERVAL_MIN=15

# Log file for the sync. Default logs/omi-sync.log.
OMI_SYNC_LOG=

# ── Local model (local-model) — off by default ────────────────────────────────
# Runs background reading of your messages on a free model on this Mac (Ollama)
# instead of paying OpenAI.

# Address of Ollama. (Required when this feature is on.)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434

# Model name in Ollama (ollama pull <name>). (Required when this feature is on.)
LOCAL_LLM_MODEL=qwen3:8b

# How long Ollama keeps the model loaded.
LOCAL_LLM_KEEP_ALIVE=30m

# Time limit per local call.
LOCAL_LLM_TIMEOUT_MS=120000

# How much text the model reads at once.
LOCAL_LLM_NUM_CTX=16384

# true = also run the quick sorting step locally.
LOCAL_LLM_PREFILTER=false

# Failures in a row before the local model is skipped for a while.
LOCAL_LLM_BREAKER_THRESHOLD=3

# Minutes to skip it after that.
LOCAL_LLM_BREAKER_COOLDOWN_MIN=15

# Path to sysctl, used by npm run model:fit.
SYSCTL_BIN=

# ── Dashboard (dashboard) — on by default ─────────────────────────────────────
# A private web page on this Mac showing what the assistant knows and is
# tracking.

# Port for http://127.0.0.1:<port>.
ASSISTANT_DASH_PORT=4000
